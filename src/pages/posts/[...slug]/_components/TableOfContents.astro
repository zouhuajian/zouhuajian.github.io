---
import type { MarkdownHeading } from "astro";

type Props = {
  headings: MarkdownHeading[];
  title: string;
};

const { headings, title } = Astro.props;
---

<aside
  aria-labelledby="table-of-contents-title"
  class="mt-8 hidden xl:col-start-2 xl:row-start-1 xl:block"
>
  <nav
    aria-labelledby="table-of-contents-title"
    data-table-of-contents
    class="border-border sticky top-8 max-h-[calc(100dvh-4rem)] overflow-y-auto border-s ps-4"
  >
    <p
      id="table-of-contents-title"
      class="text-muted-foreground m-0 text-xs font-semibold tracking-wider uppercase"
    >
      {title}
    </p>

    <ol class="mt-3 list-none space-y-1.5 p-0">
      {
        headings.map(heading => (
          <li class:list={["m-0", { "ps-3": heading.depth === 3 }]}>
            <a
              href={`#${heading.slug}`}
              data-toc-link
              data-active="false"
              class="text-muted-foreground -ms-[17px] block border-s-2 border-transparent ps-[15px] text-xs leading-5 no-underline hover:text-sky-500 data-[active=true]:border-sky-500 data-[active=true]:font-semibold data-[active=true]:text-sky-500"
            >
              {heading.text}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
</aside>
